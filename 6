class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {

        HashMap<String, List<String>> map = new HashMap<>();
        List<List<String>> result = new ArrayList<>();
        
        for(int i=0; i<strs.length; i++){
            String curr = strs[i];
            char[] s = curr.toCharArray();
            Arrays.sort(s);
            StringBuilder ns = new StringBuilder();
            for(int j=0; j<s.length; j++){
                ns.append(s[j]);
            }
            if(!map.containsKey(ns.toString())){
                map.put(ns.toString(), new ArrayList<>());
            }
            map.get(ns.toString()).add(curr);
        }

        for(List<String> bucket : map.values()){
            result.add(bucket);
        }
return result ;
    }
}


APPROACH 2

class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {

        HashMap<String, List<String>> map = new HashMap<>();

        for (String word : strs) {

            // 1. Frequency array for 26 lowercase letters
            int[] freq = new int[26];

            // 2. Count characters
            for (char c : word.toCharArray()) {
                freq[c - 'a']++;
            }

            // 3. Build a unique key from frequency array
            StringBuilder keyBuilder = new StringBuilder();
            for (int i = 0; i < 26; i++) {
                keyBuilder.append('#');
                keyBuilder.append(freq[i]);
            }

            String key = keyBuilder.toString();

            // 4. Bucket words using the key
            if (!map.containsKey(key)) {
                map.put(key, new ArrayList<>());
            }

            map.get(key).add(word);
        }

        // 5. Return all buckets
        return new ArrayList<>(map.values());
    }
}

