
T.C. => O(n)
S.C. => O(n)

class Solution {
    public int majorityElement(int[] nums) {
        int n = nums.length;
        int ans=0;
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int i=0; i< n; i++){
            map.put(nums[i], map.getOrDefault(nums[i],0)+1);
        }
        for(Map.Entry<Integer, Integer> entry: map.entrySet()){
            if(entry.getValue()>n/2){
                ans = entry.getKey();
            }
        }
        return ans;
    }
}


Boyer–Moore style:
                               T.C. => O(n)
                               S.C. => O(1)

class Solution {
    public int majorityElement(int[] nums) {
        int val = nums[0];
        int  count = 0;
        for(int i=0; i<nums.length; i++){
            int curr  = nums[i];
            if(curr == val){
                count++;
            }else{
                count--;
                if(count == 0){
                    val = curr;
                    count = 1;
                }
            }
        }
        return val;
    }
}
