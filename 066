class Solution {
    public int findMin(int[] nums) {
        int n = nums.length;
        int low = 0; 
        int high = n-1;
        int result = -1;
        while(low<=high){
            int mid = (low+high)/2;
            if(nums[mid] <= nums[n-1]){
                result = mid;
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return nums[result];
    }
}
