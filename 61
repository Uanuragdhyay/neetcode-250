class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int low = 1;
        int high = findMax(piles);
        int result = 0;
        while(low <= high){
            int mid = (low + high)/2;
            int timeTaken = findTimeTaken(piles, mid);
            if(timeTaken <= h){
                result = mid;
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return result; 
    }

    public int findMax(int [] nums){
        int max = nums[0];
        for(int i=1; i<nums.length; i++){
            max = Math.max(max, nums[i]);
        }
        return max;
    }

    public int findTimeTaken(int [] nums, int speed){
        int timeTaken = 0;
        for(int i = 0 ; i < nums.length; i++){
            if((nums[i] % speed) == 0){
                timeTaken = timeTaken + (nums[i] / speed);
            }else{
                timeTaken = timeTaken + (nums[i] / speed);
                timeTaken++;
            } 
        }
        return timeTaken;
    }




}
